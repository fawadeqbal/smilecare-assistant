# Server-side URL of the NestJS API (used by the dashboard's backend proxy)
API_URL=http://localhost:4000

# Demo clinic site: where to load the widget from, and which business it belongs to
NEXT_PUBLIC_WIDGET_SRC=http://localhost:4000/widget.js
NEXT_PUBLIC_WIDGET_KEY=pk_demo_smilecare

# Public API URL shown in the install snippet on the Settings page
NEXT_PUBLIC_API_PUBLIC_URL=http://localhost:4000
