# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:4000

# --- Data stores ---
DATABASE_URL=postgresql://smilecare:smilecare@localhost:5432/smilecare
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=43200

# Comma-separated dashboard origins allowed to call admin endpoints
ADMIN_CORS_ORIGINS=http://localhost:3000

# --- Claude (LLM) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=1024
CHAT_HISTORY_LIMIT=12
CHAT_MAX_TOOL_ROUNDS=4

# --- Embeddings ---
# voyage = Voyage AI (recommended). local = offline hashing, for development/tests only.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=300
UPLOAD_MAX_BYTES=10485760

# --- Mail ---
# console = log emails (development). smtp = send through SMTP_* below.
MAIL_PROVIDER=console
MAIL_FROM="SmileCare Assistant <no-reply@smilecare.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Rate limiting (per IP, per window) ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
CHAT_RATE_LIMIT_MAX=20

# --- Widget bundle path (relative to the API working directory) ---
WIDGET_BUNDLE_PATH=../widget/dist/widget.js

# --- Seed ---
SEED_ADMIN_EMAIL=admin@smilecare.dev
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_WIDGET_KEY=pk_demo_smilecare
