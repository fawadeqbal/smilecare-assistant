{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "infrastructure/database/migrations/**/*",
        "watchAssets": true
      },
      {
        "include": "infrastructure/database/seed-data/**/*",
        "watchAssets": true
      }
    ]
  }
}
